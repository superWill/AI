{
  "_说明": "小屏要显示/控制哪些点 —— 后台(网页/文件)配置,面板只渲染这里配的。标签可中文(字体里有的字)。",
  "_widget": "value=只读数值; setpoint=带 +/- 写寄存器; switch=开关写寄存器",
  "pages": [
    { "title": "一次侧", "tiles": [
      { "label": "供水温度", "addr": 1, "reg": 0, "scale": 0.1,  "unit": "C",   "widget": "value" },
      { "label": "供水压力", "addr": 1, "reg": 1, "scale": 0.01, "unit": "MPa", "widget": "value" },
      { "label": "供水流量", "addr": 1, "reg": 2, "scale": 0.1,  "unit": "t/h", "widget": "value" },
      { "label": "回水温度", "addr": 2, "reg": 0, "scale": 0.1,  "unit": "C",   "widget": "value" },
      { "label": "回水压力", "addr": 2, "reg": 1, "scale": 0.01, "unit": "MPa", "widget": "value" }
    ] },
    { "title": "二次侧", "tiles": [
      { "label": "供水温度", "addr": 3, "reg": 0, "scale": 0.1,  "unit": "C",   "widget": "value" },
      { "label": "供水压力", "addr": 3, "reg": 1, "scale": 0.01, "unit": "MPa", "widget": "value" },
      { "label": "供水流量", "addr": 3, "reg": 2, "scale": 0.1,  "unit": "t/h", "widget": "value" },
      { "label": "回水温度", "addr": 4, "reg": 0, "scale": 0.1,  "unit": "C",   "widget": "value" },
      { "label": "回水压力", "addr": 4, "reg": 1, "scale": 0.01, "unit": "MPa", "widget": "value" }
    ] },
    { "title": "设备", "tiles": [
      { "label": "泵频率",   "addr": 5, "reg": 1, "scale": 0.1,  "unit": "Hz", "widget": "value" },
      { "label": "泵电流",   "addr": 5, "reg": 2, "scale": 0.1,  "unit": "A",  "widget": "value" },
      { "label": "换热温度", "addr": 7, "reg": 1, "scale": 0.1,  "unit": "C",  "widget": "value" },
      { "label": "电压",     "addr": 8, "reg": 0, "scale": 0.1,  "unit": "V",  "widget": "value" },
      { "label": "电流",     "addr": 8, "reg": 1, "scale": 0.01, "unit": "A",  "widget": "value" },
      { "label": "采集 IN3", "source": "adc", "ch": 3, "scale": 1.7578, "unit": "mV", "widget": "value" }
    ] },
    { "title": "控制", "tiles": [
      { "label": "目标温度", "addr": 1, "reg": 10, "scale": 0.1, "unit": "C", "widget": "setpoint",
        "write_reg": 10, "step": 5, "min": 400, "max": 850 },
      { "label": "循环泵", "addr": 5, "reg": 0, "widget": "switch", "write_reg": 10 },
      { "label": "补给泵", "addr": 6, "reg": 0, "widget": "switch", "write_reg": 10 }
    ] }
  ]
}
