{
  "baud": 9600,
  "_说明": "模拟一个换热站的多个 Modbus 从站。寄存器 key=地址(字符串),base 固定值,swing/period_s 给正弦波动。fault: none/offline/bad_crc/exception。reg10/11 等高位寄存器供控制(write)。",
  "slaves": [
    { "addr": 1, "name": "一次供水", "registers": {
      "0": { "base": 724, "swing": 30, "period_s": 60 },
      "1": { "base": 82 }, "2": { "base": 426, "swing": 20, "period_s": 45 },
      "10": { "base": 700 } } },
    { "addr": 2, "name": "一次回水", "registers": {
      "0": { "base": 518, "swing": 20, "period_s": 70 }, "1": { "base": 78 } } },
    { "addr": 3, "name": "二次供水", "registers": {
      "0": { "base": 452, "swing": 25, "period_s": 50 }, "1": { "base": 32 },
      "2": { "base": 683, "swing": 30, "period_s": 40 } } },
    { "addr": 4, "name": "二次回水", "registers": {
      "0": { "base": 381, "swing": 18, "period_s": 65 }, "1": { "base": 24 } } },
    { "addr": 5, "name": "循环泵", "registers": {
      "0": { "base": 1 }, "1": { "base": 350, "swing": 40, "period_s": 30 },
      "2": { "base": 124, "swing": 15, "period_s": 25 }, "10": { "base": 1 } } },
    { "addr": 6, "name": "补水泵", "registers": { "0": { "base": 0 }, "10": { "base": 0 } } },
    { "addr": 7, "name": "板式换热器", "registers": {
      "0": { "base": 1 }, "1": { "base": 71, "swing": 10, "period_s": 80 } } },
    { "addr": 8, "name": "电表", "registers": {
      "0": { "base": 2200, "swing": 30, "period_s": 45 },
      "1": { "base": 529, "swing": 60, "period_s": 30 } } }
  ]
}
